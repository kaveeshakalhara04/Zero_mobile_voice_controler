<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_assistant_dialog"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header: Assistant Icon & Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_btn_speak_now" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Zer0 Voice Assistant"
                android:textColor="#A29BFE"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Listening..."
                android:textColor="#55EFC4"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- User command recognized -->
        <TextView
            android:id="@+id/tvHeardText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="&quot;Listening for command...&quot;"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="italic" />

        <!-- Feedback / Assistant Response -->
        <TextView
            android:id="@+id/tvFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#26FFFFFF"
            android:padding="12dp"
            android:text="Hello! How can I help you?"
            android:textColor="#F1F2F6"
            android:textSize="15sp" />

        <!-- Hint -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Say: Unlock phone | Open YouTube | Open Camera | Open WhatsApp"
            android:textColor="#A4B0BE"
            android:textSize="12sp" />

    </LinearLayout>
</FrameLayout>
